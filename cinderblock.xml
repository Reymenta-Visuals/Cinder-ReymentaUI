<?xml version="1.0" encoding="UTF-8" ?>
<cinder>
<block
	name="Cinder-ReymentaUI"
	id="fr.batchass.ReymentaUI"
	author="Bruce Lane"
	license="MIT"
	summary="Reymenta UI block for Cinder 0.9: imgui wrapper"
	url="https://github.com/Reymenta-Visuals/Cinder-ReymentaUI"
	git="git://github.com/Reymenta-Visuals/Cinder-ReymentaUI.git"
	core="true"
	>
	<supports os="msw" />
	<includePath>include</includePath>
	<includePath>src</includePath>
	<headerPattern>include/*.h</headerPattern>
	<sourcePattern>src/*.cpp</sourcePattern>
	<sourcePattern>src/*.c</sourcePattern>
	
	<requires>nl.cowlumbus.warping</requires>
	<requires>fr.batchass.Reymenta</requires>
	<requires>fr.batchass.ReymentaUI</requires>
	
	<platform os="msw">
		<requires>fr.batchass.spout</requires>
		<requires>mb.cinder.midi2</requires>
		
	</platform>
</block>
<template>templates/VDUI/template.xml</template>
</cinder>
